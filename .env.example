# Copy to .env for local development. On Railway, set GITHUB_TOKEN as a
# service variable / secret instead of committing it.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Optional overrides
# PORT=8000
# GITHUB_TIMEOUT_SECONDS=30

# Outbound fetch allowlist (see fetch_routes.py). Comma-separated hostnames.
# Add hosts here that the agent is allowed to READ for research, e.g.:
# FETCH_ALLOWED_HOSTS=kalshiml-production.up.railway.app,en.wikipedia.org,raw.githubusercontent.com

# Web search (see search_routes.py) — no key needed, upstream is hardcoded.
# SEARCH_TIMEOUT_S=15
# SEARCH_MAX_RESULTS=8
